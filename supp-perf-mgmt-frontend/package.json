{
  "name": "temp-next",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "format:check:staged": "node scripts/run-staged-format-check.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:staged": "node scripts/run-staged-tests.mjs",
    "test:key": "node scripts/run-key-tests.mjs",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "build:staged": "node scripts/run-conditional-build.mjs",
    "validate:precommit": "npm run lint && npm run typecheck && npm run format:check:staged && npm run test:staged && npm run test:key && npm run build:staged",
    "prepare": "husky"
  },
  "dependencies": {
    "@copilotkit/react-core": "^1.8.10",
    "@copilotkit/react-ui": "^1.8.10",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@fontsource/open-sans": "^5.3.0",
    "@fontsource/roboto": "^5.3.0",
    "@mui/icons-material": "^6.4.0",
    "@mui/material": "^6.4.0",
    "@mui/material-nextjs": "^9.1.1",
    "@tanstack/react-query": "^5.66.0",
    "next": "16.2.10",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "recharts": "^2.15.0",
    "sharp": "^0.35.3",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@playwright/test": "^1.50.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "husky": "^9.1.7",
    "jsdom": "^25.0.1",
    "prettier": "^3.9.6",
    "typescript": "^5",
    "vitest": "^3.0.4"
  }
