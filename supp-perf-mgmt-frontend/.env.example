# Browser-facing Data API base URL
# In containerized local development with in-app mocks, prefer: /api/mock
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001

# Server-internal Data API base URL (optional)
# Use this when server-side code runs in a container and cannot use the browser URL.
# Example for in-app mock routes inside the same container: http://127.0.0.1:3000/api/mock
INTERNAL_API_BASE_URL=

# Chat API
NEXT_PUBLIC_CHAT_API_BASE_URL=http://localhost:3002